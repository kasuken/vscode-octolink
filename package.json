{
  "name": "vscode-open-on-github",
  "displayName": "Open on GitHub",
  "description": "A short way to open a file on GitHub portal.",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/kasuken/vscode-open-on-github.git"
  },
  "publisher": "emanuelebartolesi",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "github",
    "open on github",
    "repository",
    "scm",
    "version control",
    "browse",
    "file history",
    "remote",
    "web",
    "git"
  ],
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-open-on-github.openFileOnGitHub",
        "title": "Open on GitHub"
      },
      {
        "command": "vscode-open-on-github.openFileHistoryOnGitHub",
        "title": "Open File History on GitHub"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vscode-open-on-github.openFileOnGitHub",
          "when": "openOnGithub.supported && resourceExtname != '' && !explorerResourceIsFolder",
          "group": "navigation@10"
        },
        {
          "command": "vscode-open-on-github.openFileHistoryOnGitHub",
          "when": "openOnGithub.supported && resourceExtname != '' && !explorerResourceIsFolder",
          "group": "navigation@11"
        }
      ],
      "commandPalette": [
        {
          "command": "vscode-open-on-github.openFileOnGitHub",
          "when": "openOnGithub.supported"
        },
        {
          "command": "vscode-open-on-github.openFileHistoryOnGitHub",
          "when": "openOnGithub.supported"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}